# Copy this file to .env and fill in your key. .env is ignored by git.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any Gemini model id works. "gemini-flash-lite-latest" always points to the current Flash-Lite
# model: fast and generous on the free tier. ("gemini-flash-latest" timed out often in testing.)
GEMINI_MODEL=gemini-flash-lite-latest

# Free-tier keys allow only a few requests per minute. Raise this if your quota is higher.
REQUESTS_PER_MINUTE=8
